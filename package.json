{
  "name": "nfl-roster-grader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:play": "VITE_TARGET=play vite build && node scripts/check-play-bundle.mjs",
    "build:demo": "vite build -c demo/vite.config.ts && node demo/inline.mjs && node demo/check-clip.mjs",
    "snapshot": "npm run build:demo && node demo/snapshot.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "worker:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "refresh": "node pipeline/cli.ts",
    "build:web": "vite build -c demo/vite.config.ts && node pipeline/build-web.ts",
    "sample": "node pipeline/make-sample.ts"
  },
  "dependencies": {
    "@app-builder/client-sdk": "file:platform/client-sdk",
    "@app-builder/host": "file:platform/host"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "22.20.5",
    "hyparquet": "1.31.5",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
